{
  "name": "stackrun",
  "version": "1.0.1",
  "description": "Run multiple local services with optional Cloudflare tunnels, including stable HTTPS hosts for OAuth callback URLs",
  "keywords": [
    "bash",
    "concurrent",
    "parallel",
    "concurrently",
    "command",
    "sh",
    "cloudflare",
    "tunnel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasenmichael/stackrun.git"
  },
  "homepage": "https://jasenmichael.github.io/stackrun/",
  "type": "module",
  "bin": {
    "stackrun": "bin/stackrun.js"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "README.md",
    "bin",
    "lib",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "prepack": "node -e \"require('fs').copyFileSync(require('path').join('..','README.md'),'README.md')\"",
    "postinstall": "node lib/postinstall.js"
  },
  "engines": {
    "node": ">=18"
  }
}
